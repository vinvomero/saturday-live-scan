---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const defaultDescription =
  'California Live Scan shops that the DOJ list marks as Saturday walk-in, city by city. Confirm hours before you go.';

const { title, description = defaultDescription } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle =
  title === 'Saturday Walk-in Live Scan (California)'
    ? title
    : `${title} · Saturday Walk-in Live Scan (California)`;
const canonical = new URL(Astro.url.pathname, 'https://vinvomero.github.io').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="site-title" href={base}>Saturday Walk-in Live Scan (California)</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
