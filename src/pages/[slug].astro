---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { FaqItem } from '../data/faq';
import { oaklandFaq, berkeleyFaq, alamedaSundayFaq, sanFranciscoFaq, oaklandCashFaq, oaklandTeacherFaq, oaklandDowntownFruitvaleFaq } from '../data/faq';
import { listingsBySlug, itemListJsonLd } from '../data/listings';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = `${entry.data.title}: DOJ-listed shops, hours, rolling fees, and skip list. Confirm before you go.`;
const faqById: Record<string, FaqItem[]> = {
  'oakland-saturday-walk-in-live-scan': oaklandFaq,
  'berkeley-saturday-walk-in-live-scan': berkeleyFaq,
  'alameda-county-sunday-live-scan': alamedaSundayFaq,
  'san-francisco-saturday-walk-in-live-scan': sanFranciscoFaq,
  'oakland-saturday-cash-live-scan': oaklandCashFaq,
  'oakland-saturday-teacher-credential-live-scan': oaklandTeacherFaq,
  'oakland-saturday-downtown-vs-fruitvale-live-scan': oaklandDowntownFruitvaleFaq,
};
const faq = faqById[entry.id];
const site = Astro.site ?? new URL('https://saturdaylivescan.com');
const base = import.meta.env.BASE_URL;
const pageUrl = new URL(`${base}${entry.id}/`, site).href;
const homeUrl = new URL(base, site).href;
const listings = listingsBySlug[entry.id] ?? [];

const extraJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: entry.data.title,
        item: pageUrl,
      },
    ],
  },
];

if (listings.length) {
  extraJsonLd.push(itemListJsonLd(listings));
}
---
<Base title={entry.data.title} description={description} faq={faq} extraJsonLd={extraJsonLd}>
  <article>
    <Content />
  </article>
</Base>
