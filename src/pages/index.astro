---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { homeFaq } from '../data/faq';

const cities = (await getCollection('cities')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const base = import.meta.env.BASE_URL;
const updated =
  cities.map((c) => String(c.data.updated)).sort().at(-1) ?? '2026-08-29';
---
<Base
  title="California Live Scan locations: hours, walk-ins, Saturday options"
  description="California Live Scan sites from the DOJ list: hours, walk-in vs appointment, rolling fees, and Saturday options by city. Confirm before you go."
  faq={homeFaq}
  website={true}
>
  <div class="hero">
    <div class="hero-left">
      <p class="eyebrow">California · DOJ-listed Live Scan sites</p>
      <h1>California Live Scan locations: hours, walk-ins, Saturday options</h1>
      <p class="lede">
        California Live Scan sites from the DOJ list: hours, walk-in vs appointment, rolling fees, and Saturday options by city. Confirm before you go.
      </p>
      <div class="hero-ctas">
        <a href="#cities" class="btn btn-primary">Browse cities</a>
        <a href={`${base}oakland-saturday-walk-in-live-scan/`} class="btn btn-secondary">Jump to Oakland</a>
      </div>
      <div class="trust-strip">
        <span class="trust-chip">{cities.length} pages live</span>
        <span class="trust-chip">DOJ-sourced rows only</span>
        <span class="trust-chip">Free directory</span>
        <span class="trust-chip">Confirm hours first</span>
      </div>
    </div>
    <div class="hero-right">
      <h2>Most searched</h2>
      <ul class="city-quick-list">
        <li>
          <a href={`${base}oakland-saturday-walk-in-live-scan/`}>Oakland walk-in</a>
          <span class="fact">7 shops, $23–$50 rolling fees</span>
        </li>
        <li>
          <a href={`${base}oakland-saturday-cash-live-scan/`}>Oakland cash</a>
          <span class="fact">All 7 Saturday walk-in rows accept cash</span>
        </li>
        <li>
          <a href={`${base}oakland-saturday-teacher-credential-live-scan/`}>Oakland teacher</a>
          <span class="fact">Form 41-LS for CTC credential</span>
        </li>
        <li>
          <a href={`${base}san-francisco-saturday-walk-in-live-scan/`}>San Francisco</a>
          <span class="fact">13 Saturday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}san-jose-saturday-walk-in-live-scan/`}>San Jose</a>
          <span class="fact">19 Saturday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}berkeley-saturday-walk-in-live-scan/`}>Berkeley</a>
          <span class="fact">5 Saturday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}sunnyvale-saturday-walk-in-live-scan/`}>Sunnyvale</a>
          <span class="fact">3 Saturday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}fremont-saturday-walk-in-live-scan/`}>Fremont</a>
          <span class="fact">6 Saturday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}alameda-county-sunday-live-scan/`}>Alameda County Sunday</a>
          <span class="fact">13 Sunday walk-in rows</span>
        </li>
        <li>
          <a href={`${base}daly-city-saturday-walk-in-live-scan/`}>Daly City</a>
          <span class="fact">4 shops, $39.99–$45</span>
        </li>
        <li>
          <a href={`${base}south-san-francisco-saturday-walk-in-live-scan/`}>South San Francisco</a>
          <span class="fact">1 shop, $39.99</span>
        </li>
      </ul>
    </div>
  </div>
  <section class="how-it-works">
    <h2>How it works</h2>
    <div class="how-steps">
      <div class="how-step">
        <div class="step-number">1</div>
        <div class="step-content">
          <p>Pick your city from the table below. Each page shows DOJ-listed shops with hours, walk-in vs appointment, and rolling fees.</p>
        </div>
      </div>
      <div class="how-step">
        <div class="step-number">2</div>
        <div class="step-content">
          <p>Bring your Form 8016 / 41-LS request form and unexpired photo ID.</p>
        </div>
      </div>
      <div class="how-step">
        <div class="step-number">3</div>
        <div class="step-content">
          <p>Go on any day the shop is open for Live Scan. Confirm hours with the shop first — the DOJ list can be stale.</p>
        </div>
      </div>
    </div>
    <p style="margin-top: 2rem; color: var(--ink-soft);">
      <strong>Oakland filters:</strong> <a href={`${base}oakland-saturday-cash-live-scan/`}>Cash Live Scan in Oakland</a> — all 7 rows accept cash. <a href={`${base}oakland-saturday-teacher-credential-live-scan/`}>Teacher credential Live Scan in Oakland</a> — Form 41-LS for CTC.
    </p>
  </section>
  <section id="cities">
    <h2>Live Scan by city</h2>
    <ul class="city-list">
      {cities.map((city) => {
        const id = city.id;
        let shortName = city.data.title.split(':')[0]?.trim().replace('Live Scan in ', '') ?? city.data.title;
        let descriptor = 'Hours, walk-ins, Saturday';
        let badge = null;
        let isFeatured = false;
        
        if (id === 'oakland-saturday-walk-in-live-scan') {
          shortName = 'Oakland';
          descriptor = '7 shops, $23–$50 rolling fees';
          badge = 'Most searched';
          isFeatured = true;
        } else if (id === 'sunnyvale-saturday-walk-in-live-scan') {
          shortName = 'Sunnyvale';
          badge = 'New';
          descriptor = '3 shops';
        } else if (id === 'oakland-saturday-cash-live-scan') {
          shortName = 'Cash Live Scan in Oakland';
          descriptor = 'Cash accepted shops';
        } else if (id === 'oakland-saturday-teacher-credential-live-scan') {
          shortName = 'Teacher credential Live Scan in Oakland (Form 41-LS)';
          descriptor = 'Teacher credential';
        } else if (id === 'oakland-saturday-downtown-vs-fruitvale-live-scan') {
          shortName = 'Downtown vs Fruitvale Live Scan in Oakland';
          descriptor = 'Downtown vs Fruitvale';
        } else if (id === 'alameda-county-sunday-live-scan') {
          shortName = 'Sunday Live Scan in Alameda County';
          descriptor = 'Sunday walk-in';
        }
        
        return (
          <li class={isFeatured ? 'city-card featured' : 'city-card'}>
            {badge && <span class="badge">{badge}</span>}
            <a href={`${base}${id}/`}>{shortName}</a>
            <span class="descriptor">{descriptor}</span>
          </li>
        );
      })}
    </ul>
  </section>
  <Faq items={homeFaq} />
  <p class="note">
    Confirm hours and fees with the shop before you go. DOJ says the public list can be stale. Nobody listed here was called.
  </p>
  <p class="updated">Updated {updated}.</p>
</Base>
