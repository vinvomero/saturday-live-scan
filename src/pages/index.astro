---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { homeFaq } from '../data/faq';

const cities = (await getCollection('cities')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const base = import.meta.env.BASE_URL;
const updated =
  cities.map((c) => String(c.data.updated)).sort().at(-1) ?? '2026-08-29';
---
<Base
  title="Saturday Walk-in Live Scan (California)"
  description="California Live Scan shops that the DOJ list marks as Saturday walk-in, city by city. Confirm hours before you go."
  faq={homeFaq}
  website={true}
>
  <h1>Saturday Walk-in Live Scan (California)</h1>
  <div class="trust-strip">
    <span class="trust-chip">{cities.length} cities</span>
    <span class="trust-chip">California walk-in focus</span>
    <span class="trust-chip">Free directory</span>
    <span class="trust-chip">Confirm hours before you go</span>
  </div>
  <p>
    California Live Scan shops that the DOJ list marks as Saturday walk-in, city by city.
  </p>
  <section class="how-it-works">
    <h2>How it works</h2>
    <div class="how-steps">
      <div class="how-step">
        <div class="step-number">1</div>
        <div class="step-content">
          <p>Find your city below and check which shops are marked Saturday walk-in.</p>
        </div>
      </div>
      <div class="how-step">
        <div class="step-number">2</div>
        <div class="step-content">
          <p>Bring your Form 8016 / 41-LS request form and ID.</p>
        </div>
      </div>
      <div class="how-step">
        <div class="step-number">3</div>
        <div class="step-content">
          <p>Walk in on Saturday. Confirm hours with the shop first — the DOJ list can be stale.</p>
        </div>
      </div>
    </div>
  </section>
  <ul class="city-list">
    {cities.map((city) => (
      <li>
        <a href={`${base}${city.id}/`}>{city.data.title}</a>
      </li>
    ))}
  </ul>
  <Faq items={homeFaq} />
  <p class="note">
    Confirm hours and fees with the shop before you go. DOJ says the public list can be stale. Nobody listed here was called.
  </p>
  <p class="updated">Updated {updated}.</p>
</Base>
